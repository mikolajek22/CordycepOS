# ---------------------------------------------------------------
# CordycepOS - konfiguracja buildu
# Ten plik to szablon. build/conf/local.conf tworzy się z niego
# tylko raz - po zmianie szablonu usuń build/conf/ i zrób source ponownie.
# ---------------------------------------------------------------

MACHINE ?= "raspberrypi5"
DISTRO ?= "poky"

PACKAGE_CLASSES ?= "package_ipk"

# Obraz karty SD + bmap dla bmaptool
IMAGE_FSTYPES = "wic.bz2 wic.bmap"

# Konsola na złączu DEBUG UART
ENABLE_UART = "1"

DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"

# DEV ONLY: root no password
EXTRA_IMAGE_FEATURES += "allow-empty-password empty-root-password allow-root-login"

# Przy konflikcie patcha przerwij build zamiast otwierać interaktywną powłokę
PATCHRESOLVE = "noop"

# Zatrzymaj build, zanim skończy się miejsce na dysku
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# Wersja formatu local.conf - wymagana przez sanity check
CONF_VERSION = "2"
