# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "7"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

##OEROOT## = sources/openembedded-core (podmieniane przy tworzeniu build/conf)
BBLAYERS ?= " \
  ##OEROOT##/meta \
  ##OEROOT##/../meta-yocto/meta-poky \
  ##OEROOT##/../meta-raspberrypi \
  ##OEROOT##/../../meta-cordycep \
  "
